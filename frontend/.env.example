# Frontend API base URL.
# Leave empty during local CRA development to use package.json proxy -> http://localhost:8080.
# Leave empty in the CloudFront production build to use same-origin /api/* routing.
# Set an absolute URL only for an explicitly approved cross-origin validation environment.
REACT_APP_API_BASE_URL=

# Explicit hosted auth selection: firebase. Omit or set cognito only for the
# historical frontend; development-only GCP preview requires cognito mode.
REACT_APP_AUTH_PROVIDER=cognito

# Public Firebase web app identifiers (not Admin credentials or secrets).
# Required when REACT_APP_AUTH_PROVIDER=firebase. F4 owns project activation,
# authorized domains, email templates, and hosted runtime configuration.
REACT_APP_FIREBASE_API_KEY=
REACT_APP_FIREBASE_AUTH_DOMAIN=
REACT_APP_FIREBASE_PROJECT_ID=
REACT_APP_FIREBASE_APP_ID=

# Cognito browser authentication.
# Real values belong in an environment-specific variable source, not in this file.
REACT_APP_AWS_REGION=
REACT_APP_COGNITO_USER_POOL_ID=
REACT_APP_COGNITO_USER_POOL_CLIENT_ID=

# Upload and analysis identifiers are created by POST /api/upload.
# Do not configure client-side project IDs, source buckets, or source object keys.

# Optional temporary GKE browser preview. This is ignored in production builds.
# Only enable with the explicit, short-lived GCP JWKS fixture described in
# docs/runbooks/gcp-local-browser-preview.md. Never put a token in an env file.
REACT_APP_GCP_BROWSER_PREVIEW=false
